# Copy to .env and fill in. NEVER commit .env or share these values.
SECRET_KEY=change-this-to-a-long-random-string
BASE_URL=http://localhost:5000          # use your https:// domain in production (needed for QR links)
ADMIN_USER=admin
ADMIN_PASSWORD=ChangeThisStrongPassword # used only the first time to create the admin
# DATA_DIR=/var/data/asma           # optional: folder that holds database/ and uploads/ (use a persistent disk in production)
# Database: leave DATABASE_URL blank to use local SQLite (database/asma.db).
# To use Supabase (PostgreSQL), paste your Supabase Connect -> Session Pooler URI below:
DATABASE_URL=
# Optional (only needed if you also use Supabase REST API / Storage):
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Payments: every online donation uses Razorpay. Set PAYMENT_MODE=razorpay and fill the three RAZORPAY_* keys
# (use Razorpay TEST keys while developing). Without them the Donate page shows "not available".
PAYMENT_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email (certificate is emailed after payment). Gmail: use an App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Donor PAN: 0 = optional for every donation. Set e.g. 50000 to make PAN mandatory from that amount.
PAN_MANDATORY_FROM=0
